# Copy to .env (git-ignored) and fill in. Never commit .env; nothing here is baked into images.
# Used both by a local `uvicorn` run and by `docker compose` (which reads it for ${...}).

# --- API keys ---
# Web-search fallback: https://tavily.com
TAVILY_API_KEY=
# Text model when LLM_PROVIDER=groq: https://console.groq.com
# GROQ_API_KEY=

# --- Model provider ---
# ollama: local llama3 + nomic-embed-text (default for a local uvicorn run).
# groq:   text from the Groq API + embeddings from Hugging Face bge-small-en-v1.5 run locally
#         (Groq has no embedding models). Docker defaults to groq unless you set this.
# LLM_PROVIDER=ollama
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_JSON_MODE=on
# HF_EMBED_MODEL=BAAI/bge-small-en-v1.5
# Each provider keeps its own collection, threads and memories (groq: backend/data/groq/).
# The web-fallback distance threshold (0.75) is calibrated for both embedding models;
# set MAX_DISTANCE only for a different one.
# MAX_DISTANCE=0.75
# Allowed dashboard origins, comma-separated (add the deployed frontend URL).
# CORS_ORIGINS=http://localhost:3000

# --- Docker: PostgreSQL (docker compose) ---
# Required by docker-compose.yml. Use URL-safe random values, e.g.:
#   python -c "import secrets; print(secrets.token_hex(24))"
# POSTGRES_* is the database owner (runs migrations only). The API connects as APP_DB_USER
# (read/write rows, no schema changes). READONLY_DB_USER is for DBeaver (see docs/DATABASE.md).
# Roles and passwords are created when the database volume is first initialised.
POSTGRES_USER=finsight_admin
POSTGRES_PASSWORD=
POSTGRES_DB=finsight
APP_DB_USER=finsight_app
APP_DB_PASSWORD=
READONLY_DB_USER=finsight_readonly
READONLY_DB_PASSWORD=
# Published on 127.0.0.1 only, in dev (docker-compose.override.yml).
# DB_PORT=5433
# API_PORT=8000
# Production (docker-compose.prod.yml): uvicorn workers and the API container's limits.
# WEB_CONCURRENCY=2
# API_MEMORY=3g
# API_CPUS=2.0

# --- Persistence (local uvicorn run) ---
# Unset = SQLite files in backend/data/ (dev without Docker). Docker sets this itself.
# DATABASE_URL=postgresql://finsight_app:password@127.0.0.1:5433/finsight
# Per worker: connections in the LangGraph pool; seconds to wait for the DB at startup.
# DB_POOL_MAX=10
# DB_CONNECT_TIMEOUT=30

# Delete threads idle longer than this many days (checkpoints + registry row).
CHECKPOINT_TTL_DAYS=30
# How often the cleanup job runs (in the API locally; the "cleanup" service in Docker).
CLEANUP_INTERVAL_HOURS=6
# How long Idempotency-Key responses are kept.
# IDEMPOTENCY_TTL_HOURS=24

# --- Memory ---
# Long-term memories read at the start of a thread.
MEMORY_SEARCH_LIMIT=5
# Embedding size: defaults to 768 (nomic-embed-text) or 384 (bge-small, groq).
# EMBED_DIMS=768
# Summarize older turns once a thread has more messages than this; keep the last KEEP_MESSAGES.
MAX_MESSAGES=12
KEEP_MESSAGES=6
